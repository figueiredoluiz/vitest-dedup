#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
work=$(mktemp -d "${TMPDIR:-/tmp}/vitest-dedup-hook-driver.XXXXXX")
trap 'rm -rf "$work"' 0
trap 'exit 1' HUP INT TERM
cd "$root"
cat > "$work/refs"
seen=' '
while read -r local_ref local_oid remote_ref remote_oid extra || [ -n "${local_ref:-}" ]; do
  [ -n "$local_ref" ] && [ -n "$remote_ref" ] && [ -z "$extra" ] || { echo 'Malformed pre-push ref input' >&2; exit 1; }
  for oid in "$local_oid" "$remote_oid"; do
    case "$oid" in ''|*[!0-9a-f]*) echo 'Malformed pre-push object ID' >&2; exit 1 ;; esac
    [ "${#oid}" -eq 40 ] || [ "${#oid}" -eq 64 ] || { echo 'Malformed pre-push object ID' >&2; exit 1; }
  done
  case "$local_oid" in *[!0]*) ;; *) continue ;; esac
  case "$seen" in *" $local_oid "*) continue ;; esac
  seen="$seen$local_oid "
  # Each proposed commit supplies its own driver, independent of the current checkout.
  git show "$local_oid:scripts/dev/verify.mjs" > "$work/verify.mjs"
  awk -v oid="$local_oid" '$2 == oid' "$work/refs" > "$work/selected-refs"
  node "$work/verify.mjs" pre-push "$@" < "$work/selected-refs"
done < "$work/refs"
